// rules/firestore.rules
// ---------------------------------------------------------
// Security Rules ของ Firestore
// หลักการสำคัญ: ผู้เล่น "ห้าม" แก้ไขค่า gold, exp, หรือ finalStats
// ของตัวเองโดยตรงจากฝั่ง client — การเปลี่ยนแปลงค่าเหล่านี้ต้องทำผ่าน
// Cloud Functions หรือ Manager ฝั่ง server-trusted เท่านั้น (เช่น
// การเรียกผ่าน Cloud Functions callable แทนการเขียน SDK ตรง ๆ จาก client
// ในโปรดักชันจริง ควรย้าย logic ใน inventoryManager/lootManager ไปรันบน
// Cloud Functions เพื่อให้ rules เหล่านี้บังคับใช้ได้อย่างสมบูรณ์)
// ---------------------------------------------------------

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- players/{userId} ----------
    match /players/{userId} {
      // อ่านได้เฉพาะเจ้าของข้อมูล หรือสมาชิกในปาร์ตี้เดียวกัน (ปรับตามต้องการ)
      allow read: if request.auth != null && request.auth.uid == userId;

      // สร้างเอกสารผู้เล่นครั้งแรกได้เฉพาะเจ้าของ uid เท่านั้น
      allow create: if request.auth != null && request.auth.uid == userId;

      // การอัปเดต: อนุญาตเฉพาะเจ้าของ และ "ห้าม" แตะฟิลด์ gold, exp, finalStats โดยตรง
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['gold', 'exp', 'finalStats', 'level']);

      // ห้ามลบเอกสารผู้เล่นจากฝั่ง client
      allow delete: if false;
    }

    // ---------- rooms/{roomCode} — ห้องปาร์ตี้ ----------
    match /rooms/{roomCode} {
      // สมาชิกในห้อง (หรือผู้ที่ auth แล้ว) อ่านข้อมูลห้องได้ เพื่อดูสถานะปาร์ตี้
      allow read: if request.auth != null;

      // สร้างห้องได้เมื่อผู้สร้างคือ hostId ที่ตรงกับ auth.uid
      allow create: if request.auth != null
                    && request.resource.data.hostId == request.auth.uid;

      // อัปเดตห้องได้เฉพาะผู้ที่เป็นสมาชิกอยู่แล้ว (join/selectCharacter)
      allow update: if request.auth != null
                    && resource.data.members.hasAny([{ 'userId': request.auth.uid }])
                       || request.auth.uid == resource.data.hostId;

      allow delete: if request.auth != null && request.auth.uid == resource.data.hostId;
    }
  }
}
